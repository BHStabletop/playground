---
import Layout from "../layouts/Layout.astro";
import YouTubeVideo from "../components/YouTubeVideo.astro";
import { useTranslations, type Lang } from "../i18n/ui";

const lang: Lang = "de";
const t = useTranslations(lang);
---

<Layout title={`Über die Marke | Playground`}>
  <section class="pg-section">
    <div class="pg-prose">
      <p class="pg-eyebrow">Über uns</p>
      <h1>Unsere Marke</h1>

      <p>
        Willkommen auf der Seite über unsere Marke. Hier erzählen wir dir, wer wir sind und wofür wir stehen.
      </p>

      <h2>Unsere Geschichte</h2>
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
      </p>

      <h2>Unser Video</h2>
      <p>
        Schau dir unser Video an, um mehr über uns zu erfahren. Das Video wird nur angezeigt, wenn du Cookies akzeptierst.
      </p>
    </div>

    <YouTubeVideo
      videoId="TkQyIPEEdGs"
      title="Über unsere Marke"
      height={500}
    />

    <div class="pg-prose">
      <h2>Unsere Werte</h2>
      <p>
        Qualität, Nachhaltigkeit und Kundenzufriedenheit sind die Grundpfeiler unseres Handelns.
      </p>
    </div>
  </section>
</Layout>

<style>
  :global(.yt-video-container) {
    margin: 3rem auto;
  }
</style>
