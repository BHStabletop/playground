---
import "../styles/global.css";
import CookieBanner from "../components/CookieBanner.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLangFromUrl, useTranslations } from "../i18n/ui";
import { GTM_ID } from "../consts";

interface Props {
  title?: string;
  description?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title = t("site.title"), description = t("site.description") } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    {/* Google Fonts - only load if user consented */}
    <script is:inline>
      function loadGoogleFonts() {
        try {
          const consent = localStorage.getItem("cookie-consent");
          if (consent === "accepted" && !document.querySelector('link[href*="fonts.googleapis.com"]')) {
            // Load Inter font from Google Fonts
            const link = document.createElement("link");
            link.href = "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap";
            link.rel = "stylesheet";
            document.head.appendChild(link);
          }
        } catch (e) {}
      }

      // Load fonts immediately if already consented
      loadGoogleFonts();

      // Also load when user consents
      window.addEventListener("cookie-consent-updated", loadGoogleFonts);
    </script>

    {
      GTM_ID && (
        <>
          <script is:inline define:vars={{ GTM_ID }}>
            // Initialize dataLayer and Consent Mode FIRST
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }

            // Set consent to DENIED by default (no tracking until user consents)
            gtag("consent", "default", {
              ad_storage: "denied",
              ad_user_data: "denied",
              ad_personalization: "denied",
              analytics_storage: "denied",
              wait_for_update: 500,
            });

            // Only load GTM if user has ALREADY consented (on return visits)
            function loadGTMIfConsented() {
              try {
                const consent = localStorage.getItem("cookie-consent");
                if (consent === "accepted") {
                  // Update consent to GRANTED
                  gtag("consent", "update", { analytics_storage: "granted" });
                  // Load GTM script only if not already loaded
                  if (!document.querySelector(`script[src*="googletagmanager"]`)) {
                    (function (w, d, s, l, i) {
                      w[l] = w[l] || [];
                      w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
                      var f = d.getElementsByTagName(s)[0],
                        j = d.createElement(s),
                        dl = l != "dataLayer" ? "&l=" + l : "";
                      j.async = true;
                      j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
                      f.parentNode.insertBefore(j, f);
                    })(window, document, "script", "dataLayer", GTM_ID);
                  }
                }
              } catch (e) {
                // localStorage might be disabled - consent remains denied
              }
            }

            // IMPORTANT: Only load GTM on page load IF already consented
            loadGTMIfConsented();

            // Listen for user consent changes and load GTM when they accept
            window.addEventListener("cookie-consent-updated", (e) => {
              loadGTMIfConsented();
            });
          </script>
        </>
      )
    }
  </head>
  <body class="font-sans antialiased">
    {/* GTM noscript fallback - will only work if user has given consent */}

    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
