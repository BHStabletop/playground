---
import { getLangFromUrl, useTranslations } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const email = t("contact.email");
---

<section id="kontakt" class="pg-section pg-contact">
  <p class="pg-eyebrow">{t("contact.eyebrow")}</p>
  <h2>{t("contact.heading")}</h2>
  <p class="pg-contact__body">{t("contact.body")}</p>
  <a class="pg-btn" href={`mailto:${email}`}>{t("contact.cta")}</a>
  <a class="pg-contact__email" href={`mailto:${email}`}>{email}</a>
</section>

<style>
  .pg-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
  }
  .pg-contact h2 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    margin: 0;
  }
  .pg-contact__body {
    max-width: 520px;
    color: var(--color-text-muted);
    margin: 0;
    font-size: 1.125rem;
  }
  .pg-contact__email {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .pg-contact__email:hover {
    color: var(--color-accent);
  }
</style>
