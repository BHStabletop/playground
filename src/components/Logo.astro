---
interface Props {
  tone?: "accent" | "white";
  class?: string;
}

const { tone = "accent", class: className = "" } = Astro.props;
const src = tone === "white" ? "/images/logo-playground-weiss.png" : "/images/logo-playground-orange.png";
---

<img class:list={["pg-logo", className]} src={src} alt="PLAYGROUND" width="625" height="104" />

<style>
  .pg-logo {
    display: block;
    height: clamp(24px, 1rem + 1.2vw, 38px);
    width: auto;
  }
</style>
