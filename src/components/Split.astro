---
/**
 * Figma-Sektionsmuster: vertikal gesetzte orange Überschrift in einer schmalen Spalte,
 * daneben der Inhalt. `side` legt fest, wo die Überschrift steht; der Inhalt läuft
 * zur gegenüberliegenden Seite bis an den Bildschirmrand (`bleed`).
 */
interface Props {
  heading: string;
  side?: "left" | "right";
  bleed?: boolean;
  id?: string;
  as?: "h1" | "h2";
}

const { heading, side = "left", bleed = false, id, as: Tag = "h2" } = Astro.props;
---

<section id={id} class:list={["pg-split", `pg-split--${side}`, { "pg-split--bleed": bleed }]}>
  <Tag class="pg-split__heading"><span>{heading}</span></Tag>
  <div class="pg-split__body">
    <slot />
  </div>
</section>

<style>
  .pg-split {
    --rail: 160px;
    max-width: var(--page-max);
    margin: 0 auto;
    padding-block: calc(var(--section-gap) / 2);
    display: grid;
    grid-template-columns: var(--content-inset) var(--rail) minmax(0, 1fr) var(--content-inset);
    align-items: start;
  }
  .pg-split--left .pg-split__heading {
    grid-column: 2;
  }
  .pg-split--left .pg-split__body {
    grid-column: 3;
  }
  .pg-split--left.pg-split--bleed .pg-split__body {
    grid-column: 3 / -1;
  }
  .pg-split--right {
    grid-template-columns: var(--content-inset) minmax(0, 1fr) var(--rail) var(--content-inset);
  }
  .pg-split--right .pg-split__heading {
    grid-column: 3;
    grid-row: 1;
    justify-self: end;
  }
  .pg-split--right .pg-split__body {
    grid-column: 2;
    grid-row: 1;
  }
  .pg-split--right.pg-split--bleed .pg-split__body {
    grid-column: 1 / 3;
  }

  .pg-split__heading {
    margin: 0;
    color: var(--color-accent);
    font-size: clamp(2.5rem, 1.6rem + 2.6vw, 3.75rem);
    line-height: 1;
    writing-mode: vertical-rl;
    text-orientation: sideways;
    transform: rotate(180deg);
    white-space: nowrap;
  }
  .pg-split--right .pg-split__heading {
    text-align: right;
  }

  @media (max-width: 820px) {
    .pg-split,
    .pg-split--right {
      grid-template-columns: 20px minmax(0, 1fr) 20px;
      row-gap: 28px;
    }
    .pg-split .pg-split__heading,
    .pg-split--right .pg-split__heading {
      grid-column: 2;
      grid-row: 1;
      justify-self: start;
      writing-mode: horizontal-tb;
      transform: none;
      white-space: normal;
    }
    .pg-split .pg-split__body,
    .pg-split--right .pg-split__body {
      grid-column: 2;
      grid-row: 2;
    }
    .pg-split--left.pg-split--bleed .pg-split__body {
      grid-column: 2 / -1;
    }
    .pg-split--right.pg-split--bleed .pg-split__body {
      grid-column: 1 / 3;
    }
  }
</style>
