---
import { getLangFromUrl, useTranslations } from "../i18n/ui";

/** Horizontale Bildstrecke mit Pfeilen (Figma: Kollektionen-Teaser, „On stage“). Slides kommen über den Slot. */
interface Props {
  label: string;
}

const { label } = Astro.props;
const t = useTranslations(getLangFromUrl(Astro.url));
---

<div class="pg-slider" data-slider>
  <div class="pg-slider__track" data-track role="region" aria-label={label} tabindex="0">
    <slot />
  </div>
  <div class="pg-slider__controls">
    <button type="button" data-prev aria-label={t("slider.prev")}>
      <svg width="12" height="19" viewBox="0 0 12 19" aria-hidden="true"><path d="M10 2 3 9.5 10 17" fill="none" stroke="currentColor" stroke-width="3"></path></svg>
    </button>
    <button type="button" data-next aria-label={t("slider.next")}>
      <svg width="12" height="19" viewBox="0 0 12 19" aria-hidden="true"><path d="m2 2 7 7.5L2 17" fill="none" stroke="currentColor" stroke-width="3"></path></svg>
    </button>
  </div>
</div>

<style>
  .pg-slider {
    position: relative;
  }
  .pg-slider__track {
    display: flex;
    gap: clamp(16px, 6.6vw, 97px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  .pg-slider__track::-webkit-scrollbar {
    display: none;
  }
  .pg-slider__track > :global(*) {
    scroll-snap-align: start;
    flex: none;
  }
  .pg-slider__controls {
    display: flex;
    gap: 20px;
    margin-top: 20px;
  }
  /* Desktop: Pfeile sitzen in der Überschriften-Spalte der umgebenden Split-Sektion */
  @media (min-width: 821px) {
    .pg-slider__controls {
      position: absolute;
      left: -160px;
      bottom: 8px;
      margin: 0;
    }
  }
  .pg-slider__controls button {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin: -6px;
    background: none;
    border: 0;
    color: #fff;
    cursor: pointer;
  }
  .pg-slider__controls button:hover {
    color: var(--color-accent);
  }
  .pg-slider__controls button:disabled {
    opacity: 0.3;
    cursor: default;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-slider]").forEach((slider) => {
    const track = slider.querySelector<HTMLElement>("[data-track]");
    const prev = slider.querySelector<HTMLButtonElement>("[data-prev]");
    const next = slider.querySelector<HTMLButtonElement>("[data-next]");
    if (!track || !prev || !next) return;

    const step = () => {
      const first = track.firstElementChild as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return first ? first.offsetWidth + gap : track.clientWidth;
    };
    const update = () => {
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 2;
    };

    prev.addEventListener("click", () => track.scrollBy({ left: -step() }));
    next.addEventListener("click", () => track.scrollBy({ left: step() }));
    track.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  });
</script>
