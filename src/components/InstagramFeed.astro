---
import { getLangFromUrl, useTranslations } from "../i18n/ui";

interface Props {
  /** Public Instagram profile URL used for the "see more" button. */
  profileUrl?: string;
}

const { profileUrl = "https://www.instagram.com/" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="instagram" class="pg-section pg-insta">
  <h2>{t("instagram.title")}</h2>
  <p>{t("instagram.subtitle")}</p>

  <div
    id="instagram-feed"
    data-loading={t("instagram.loading")}
    data-empty={t("instagram.empty")}
    data-error={t("instagram.error")}
    class="pg-insta__grid"
  >
    <p class="pg-insta__status">{t("instagram.loading")}</p>
  </div>

  <a class="pg-btn pg-btn--secondary" href={profileUrl} target="_blank" rel="noopener noreferrer">
    {t("instagram.cta")}
  </a>
</section>

<style>
  .pg-insta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
  }
  .pg-insta h2 {
    font-size: clamp(2rem, 1.6rem + 2vw, 3.5rem);
    margin: 0;
  }
  .pg-insta > p {
    max-width: 560px;
    margin: 0;
    color: var(--color-text-muted);
  }
  .pg-insta__grid {
    width: 100%;
    max-width: 1100px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 1fr;
    gap: 8px;
    align-items: start;
  }
  .pg-insta__grid a {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
  }
  .pg-insta__grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-base) var(--ease-soft);
  }
  .pg-insta__grid a:hover img {
    transform: scale(1.03);
  }
  .pg-insta__status {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
  }

  @media (min-width: 500px) {
    .pg-insta__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>

<script>
  interface InstagramPost {
    id: string;
    caption: string;
    mediaUrl: string;
    permalink: string;
  }

  async function loadInstagramFeed() {
    const container = document.getElementById("instagram-feed");
    if (!container) return;

    const showMessage = (text: string) => {
      container.replaceChildren();
      const p = document.createElement("p");
      p.className = "pg-insta__status";
      p.textContent = text;
      container.appendChild(p);
    };

    try {
      const res = await fetch("/api/instagram");
      if (!res.ok) throw new Error(`request failed with ${res.status}`);

      const data: { posts: InstagramPost[] } = await res.json();
      const posts = (data.posts ?? []).slice(0, 12);

      if (!posts.length) {
        showMessage(container.dataset.empty ?? "");
        return;
      }

      container.replaceChildren();
      for (const post of posts) {
        const link = document.createElement("a");
        link.href = post.permalink;
        link.target = "_blank";
        link.rel = "noopener noreferrer";

        const img = document.createElement("img");
        img.src = post.mediaUrl;
        img.alt = post.caption ? post.caption.slice(0, 140) : "";
        img.loading = "lazy";

        link.appendChild(img);
        container.appendChild(link);
      }
    } catch {
      showMessage(container.dataset.error ?? "");
    }
  }

  loadInstagramFeed();
</script>
