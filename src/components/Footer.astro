---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/ui";
import { INSTAGRAM_URL, INSTAGRAM_HANDLE } from "../consts";
import Logo from "./Logo.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer class="pg-footer">
  <div class="pg-footer__inner">
    <a href={getLocalizedPath("/", lang)} class="pg-footer__logo"><Logo tone="white" /></a>

    <nav class="pg-footer__links" aria-label="Footer">
      <a href={getLocalizedPath("/impressum", lang)}>{t("footer.impressum")}</a>
      <a href={getLocalizedPath("/datenschutz", lang)}>{t("footer.datenschutz")}</a>
      <a href={getLocalizedPath("/#kontakt", lang)}>{t("nav.contact")}</a>
    </nav>

    <a class="pg-btn pg-btn--dark pg-footer__insta" href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer" aria-label={t("footer.instagram")}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
      </svg>
      {INSTAGRAM_HANDLE}
    </a>

    <p class="pg-footer__copy">{t("footer.copy")}</p>
    <button type="button" class="pg-footer__cookies" id="pg-cookie-settings">{t("footer.cookieSettings")}</button>
  </div>
</footer>

<style>
  .pg-footer {
    background: var(--color-accent);
    color: #fff;
  }
  .pg-footer__inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(48px, 6.3vw, 91px) var(--content-inset) 40px;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "logo links"
      "copy insta"
      "cookies .";
    align-items: center;
    gap: 20px 40px;
  }
  .pg-footer__logo {
    grid-area: logo;
    text-decoration: none;
  }
  .pg-footer__links {
    grid-area: links;
    display: flex;
    flex-wrap: wrap;
    gap: 12px clamp(24px, 3vw, 40px);
  }
  .pg-footer__links a {
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
  }
  .pg-footer__links a:hover,
  .pg-footer__cookies:hover {
    opacity: 0.75;
  }
  .pg-footer__insta {
    grid-area: insta;
    justify-self: end;
    width: 300px;
    max-width: 100%;
  }
  .pg-footer__copy {
    grid-area: copy;
    font-size: 0.9375rem;
    margin: 0;
  }
  .pg-footer__cookies {
    grid-area: cookies;
    justify-self: start;
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font: inherit;
    font-size: 0.9375rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  @media (max-width: 760px) {
    .pg-footer__inner {
      grid-template-columns: 1fr;
      grid-template-areas: "logo" "links" "insta" "copy" "cookies";
    }
    .pg-footer__insta {
      justify-self: start;
    }
  }
</style>

<script>
  document.getElementById("pg-cookie-settings")?.addEventListener("click", () => {
    window.dispatchEvent(new CustomEvent("cookie-consent:open"));
  });
</script>
