---
import { getLangFromUrl, useTranslations, getLocalizedPath, type Lang } from "../i18n/ui";
import type { Product } from "../data/products";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const lang = getLangFromUrl(Astro.url) as Lang;
const t = useTranslations(lang);
const href = getLocalizedPath(`/produkte/${product.slug}`, lang);
---

<a class="pg-card" href={href} style={`--card-accent:${product.accent ?? "var(--color-accent)"}`}>
  <div class="pg-card__media">
    <img src={product.image} alt={product.name[lang]} loading="lazy" />
  </div>
  <div class="pg-card__body">
    <h3>{product.name[lang]}</h3>
    <p class="pg-card__tagline">{product.tagline[lang]}</p>
    <span class="pg-card__cta">{t("products.cta")} →</span>
  </div>
</a>

<style>
  .pg-card {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-surface);
    text-decoration: none;
    color: var(--color-text);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: transform var(--dur-base) var(--ease-soft), border-color var(--dur-base) var(--ease-soft);
  }
  .pg-card:hover {
    transform: translateY(-4px);
    border-color: var(--card-accent);
  }
  .pg-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: color-mix(in srgb, var(--card-accent) 18%, var(--color-surface));
  }
  .pg-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow, 520ms) var(--ease-soft);
  }
  .pg-card:hover .pg-card__media img {
    transform: scale(1.04);
  }
  .pg-card__body {
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .pg-card__body h3 {
    margin: 0;
    font-size: 1.4rem;
  }
  .pg-card__tagline {
    margin: 0;
    color: var(--color-text-muted);
  }
  .pg-card__cta {
    margin-top: 10px;
    color: var(--card-accent);
    font-weight: 600;
  }
</style>
