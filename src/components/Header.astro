---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/ui";
import { collections } from "../data/collections";
import Logo from "./Logo.astro";
import LanguageSwitch from "./LanguageSwitch.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const path = (p: string) => getLocalizedPath(p, lang);

const items = [
  { href: path("/"), label: t("nav.home") },
  { href: path("/kollektionen"), label: t("nav.collections"), children: true },
  { href: path("/ueber-die-marke"), label: t("nav.about") },
];
---

<header class="pg-header">
  <a href={path("/")} class="pg-header__logo"><Logo /></a>
  <button
    type="button"
    class="pg-burger"
    id="pg-burger"
    aria-label={t("nav.menu")}
    aria-expanded="false"
    aria-controls="pg-menu"
  >
    <span></span><span></span><span></span>
  </button>
</header>

<div class="pg-menu" id="pg-menu" hidden>
  <div class="pg-menu__top">
    <a href={path("/")} class="pg-header__logo" tabindex="-1" aria-hidden="true"><Logo tone="white" class="pg-menu__ghost" /></a>
    <button type="button" class="pg-menu__close" id="pg-menu-close" aria-label={t("nav.close")}>
      <span></span><span></span>
    </button>
  </div>

  <nav class="pg-menu__nav" aria-label={t("nav.main")}>
    <ol class="pg-menu__list">
      {
        items.map((item, i) => (
          <li class="pg-menu__item">
            <span class="pg-menu__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <a class="pg-menu__link" href={item.href}>{item.label}</a>
            {item.children && (
              <ul class="pg-menu__sub">
                {collections.map((c) => (
                  <li>
                    <a href={path(`/kollektionen/${c.slug}`)}>{c.name}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>

    <div class="pg-menu__meta">
      <LanguageSwitch />
      <a href={path("/impressum")}>{t("footer.impressum")}</a>
      <a href={path("/datenschutz")}>{t("footer.datenschutz")}</a>
      <a href={path("/#kontakt")}>{t("nav.contact")}</a>
    </div>
  </nav>
</div>

<style>
  .pg-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(20px, 3.6vw, 52px) clamp(20px, 4.9vw, 70px) 0;
    pointer-events: none;
  }
  .pg-header::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 120px;
    background: rgba(0, 0, 0, 0.4);
    filter: blur(50px);
    z-index: -1;
  }
  .pg-header > * {
    pointer-events: auto;
  }
  .pg-header__logo {
    text-decoration: none;
  }
  .pg-burger,
  .pg-menu__close {
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -2px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .pg-burger span {
    position: absolute;
    left: 2px;
    width: 40px;
    height: 3px;
    background: #fff;
  }
  .pg-burger span:nth-child(1) {
    top: 8px;
  }
  .pg-burger span:nth-child(2) {
    top: 20px;
  }
  .pg-burger span:nth-child(3) {
    top: 32px;
  }

  .pg-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    overflow-y: auto;
    background: rgba(237, 107, 28, 0.95);
    color: #fff;
    padding: clamp(20px, 3.6vw, 52px) clamp(20px, 4.9vw, 70px) 48px;
  }
  .pg-menu[hidden] {
    display: none;
  }
  .pg-menu__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pg-menu__ghost {
    opacity: 0.25;
  }
  .pg-menu__close span {
    position: absolute;
    left: 2px;
    top: 20px;
    width: 40px;
    height: 3px;
    background: #fff;
    transform: rotate(45deg);
  }
  .pg-menu__close span + span {
    transform: rotate(-45deg);
  }

  .pg-menu__nav {
    max-width: 946px;
    margin: clamp(40px, 6vw, 90px) auto 0;
  }
  .pg-menu__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(28px, 4vw, 56px);
  }
  .pg-menu__item {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: 24px;
  }
  .pg-menu__num {
    font-family: var(--font-display-stack);
    font-weight: 700;
    font-size: clamp(3.5rem, 2rem + 5vw, 7.5rem);
    line-height: 0.8;
    color: rgba(255, 255, 255, 0.4);
  }
  .pg-menu__link {
    justify-self: end;
    text-align: right;
    font-family: var(--font-display-stack);
    font-weight: 700;
    font-size: clamp(2rem, 1.2rem + 2.8vw, 3.75rem);
    line-height: 1;
    text-decoration: none;
  }
  .pg-menu__link:hover,
  .pg-menu__sub a:hover,
  .pg-menu__meta a:hover {
    opacity: 0.75;
  }
  .pg-menu__sub {
    grid-column: 1 / -1;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 10px clamp(24px, 3.4vw, 48px);
  }
  .pg-menu__sub a {
    font-size: clamp(1rem, 0.9rem + 0.3vw, 1.25rem);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-decoration: none;
  }
  .pg-menu__meta {
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: clamp(24px, 3vw, 40px);
    border-top: 1px solid rgba(255, 255, 255, 0.8);
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 12px clamp(24px, 3.4vw, 50px);
    font-size: 1.25rem;
  }
  .pg-menu__meta > :first-child {
    margin-right: auto;
  }
  .pg-menu__meta a {
    text-decoration: none;
  }
  .pg-menu__meta :global(.pg-lang a) {
    color: rgba(255, 255, 255, 0.7);
  }
  .pg-menu__meta :global(.pg-lang a.is-active) {
    color: #fff;
  }

  @media (max-width: 640px) {
    .pg-menu__item {
      grid-template-columns: 1fr;
    }
    .pg-menu__num {
      font-size: 2.5rem;
    }
    .pg-menu__link {
      justify-self: start;
      text-align: left;
    }
    .pg-menu__sub {
      justify-content: flex-start;
    }
    .pg-menu__meta {
      justify-content: flex-start;
    }
    .pg-menu__meta > :first-child {
      flex-basis: 100%;
    }
  }
</style>

<script>
  const burger = document.getElementById("pg-burger");
  const menu = document.getElementById("pg-menu");
  const close = document.getElementById("pg-menu-close");

  function setOpen(open: boolean) {
    if (!menu || !burger) return;
    menu.hidden = !open;
    burger.setAttribute("aria-expanded", String(open));
    document.documentElement.style.overflow = open ? "hidden" : "";
    (open ? close : burger)?.focus();
  }

  burger?.addEventListener("click", () => setOpen(true));
  close?.addEventListener("click", () => setOpen(false));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.hidden) setOpen(false);
  });
</script>
