---
import { getLangFromUrl, useTranslations, getLocalizedPath } from "../i18n/ui";
import LanguageSwitch from "./LanguageSwitch.astro";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const current = Astro.url.pathname;
const links = [
  { href: getLocalizedPath("/", lang), label: t("nav.home") },
  { href: getLocalizedPath("/produkte", lang), label: t("nav.products") },
  { href: getLocalizedPath("/#ueber-uns", lang), label: t("nav.about") },
  { href: getLocalizedPath("/#kontakt", lang), label: t("nav.contact") },
];

const isActive = (href: string) => {
  const clean = href.split("#")[0];
  return clean !== "/" && clean !== "/en" && current.startsWith(clean);
};
---

<header class="pg-header">
  <div class="pg-header__inner">
    <a href={getLocalizedPath("/", lang)} class="pg-logo">Playground</a>

    <nav class="pg-nav" id="pg-nav" aria-label="Hauptnavigation">
      {
        links.map((l) => (
          <a href={l.href} class={isActive(l.href) ? "is-active" : ""}>
            {l.label}
          </a>
        ))
      }
      <LanguageSwitch />
    </nav>

    <button type="button" class="pg-burger" id="pg-burger" aria-label={t("nav.menu")} aria-expanded="false" aria-controls="pg-nav">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .pg-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-ground) 85%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .pg-header__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 16px clamp(20px, 6vw, 60px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .pg-logo {
    font-family: var(--font-display-stack);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .pg-nav {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.5vw, 32px);
  }
  .pg-nav > a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 1rem;
  }
  .pg-nav > a:hover,
  .pg-nav > a.is-active {
    color: var(--color-text);
  }
  .pg-burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 6px;
  }
  .pg-burger span {
    width: 24px;
    height: 2px;
    background: var(--color-text);
    display: block;
  }

  @media (max-width: 820px) {
    .pg-burger {
      display: flex;
    }
    .pg-nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      padding: 24px clamp(20px, 6vw, 60px);
      background: var(--color-ground);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      display: none;
    }
    .pg-nav.is-open {
      display: flex;
    }
  }
</style>

<script>
  const burger = document.getElementById("pg-burger");
  const nav = document.getElementById("pg-nav");
  burger?.addEventListener("click", () => {
    const open = nav?.classList.toggle("is-open");
    burger.setAttribute("aria-expanded", open ? "true" : "false");
  });
  // Menü schließen, wenn ein Link geklickt wird
  nav?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      nav.classList.remove("is-open");
      burger?.setAttribute("aria-expanded", "false");
    }),
  );
</script>
