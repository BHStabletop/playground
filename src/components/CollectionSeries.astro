---
import type { Series } from "../data/collections";

/**
 * Eine Serie als Bild mit Versal-Label (noch kein Link: es gibt keine Serien-Seiten).
 * Figma: Label wird bei Hover orange (dort als Beispiel bei ELEMENTS / CAST IRON / ANANTI gezeigt).
 */
interface Props {
  series: Series;
  size: "tile" | "feature" | "mid" | "banner";
}

const { series, size } = Astro.props;
---

<figure class:list={["cs", `cs--${size}`]}>
  <img src={series.image} alt="" loading="lazy" decoding="async" />
  <figcaption class="pg-label cs__label">{series.name}</figcaption>
</figure>

<style>
  .cs {
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .cs img {
    width: 100%;
    height: auto;
    object-fit: cover;
    background: var(--color-surface);
  }
  .cs--tile img {
    aspect-ratio: 220 / 250;
  }
  .cs--feature img {
    aspect-ratio: 460 / 678;
  }
  .cs--mid img {
    aspect-ratio: 380 / 282;
  }
  .cs--banner img {
    aspect-ratio: 940 / 282;
  }
  .cs--feature,
  .cs--mid,
  .cs--banner {
    gap: 31px;
  }

  .cs__label {
    /* Figma: 22px bold, +1.1px, Zeilenbox 31px */
    font-size: clamp(0.8125rem, 0.6rem + 0.86vw, 1.375rem);
    line-height: 1.4;
    transition: color var(--dur-fast) var(--ease-soft);
  }
  .cs--tile .cs__label {
    text-align: center;
  }
  .cs:hover .cs__label,
  .cs:focus-within .cs__label {
    color: var(--color-accent);
  }

  @media (max-width: 820px) {
    .cs {
      gap: 16px;
    }
    .cs--feature,
    .cs--mid,
    .cs--banner {
      gap: 16px;
    }
  }
</style>
